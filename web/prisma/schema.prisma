generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OWNER
  RENTER
  BUYER
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
  SUSPENDED
}

enum TransactionType {
  RENT
  SALE
}

enum PropertyStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  PUBLISHED
  REJECTED
  SUSPENDED
  SOLD
  RENTED
  ARCHIVED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
  FAILED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  COMPLETED
  FAILED
  CANCELLED
  EXPIRED
}

enum RentalStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  ACTIVE
  COMPLETED
  TERMINATED
}

enum SaleStatus {
  PENDING
  ACCEPTED
  REJECTED
  UNDER_REVIEW
  LEGAL_PROCESS
  COMPLETED
  CANCELLED
}

model User {
  id                 String             @id @default(uuid())
  name               String
  email              String             @unique
  phone              String             @unique
  passwordHash       String
  roles              Role[]             @default([RENTER])
  role               String?            @default("RENTER")
  avatarUrl          String?
  avatar             String?
  isPhoneVerified    Boolean            @default(false)
  isEmailVerified    Boolean            @default(false)
  isIdentityVerified Boolean            @default(false)
  address            String?
  city               String?            @default("Addis Ababa")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  identityDocuments    IdentityDocument[]
  licenses             License[]
  properties           Property[]         @relation("OwnerProperties")
  subscriptions        Subscription[]
  payments             Payment[]
  rentalRequestsSent   RentalRequest[]    @relation("RenterRequests")
  rentalRequestsRecv   RentalRequest[]    @relation("OwnerRentalRequests")
  saleRequestsSent     SaleRequest[]      @relation("BuyerRequests")
  saleRequestsRecv     SaleRequest[]      @relation("OwnerSaleRequests")
  favorites            Favorite[]
  messagesSent         Message[]          @relation("SentMessages")
  messagesReceived     Message[]          @relation("ReceivedMessages")
  notifications        Notification[]
  reviews              Review[]
  reports              Report[]
  auditLogs            AuditLog[]
  analyticsEvents      AnalyticsEvent[]
  savedAddresses       SavedAddress[]
  pushSubscriptions   PushSubscription[]
  serviceBookings      ServiceBooking[]
  assignedServices     ServiceBooking[]   @relation("AssignedProvider")
  serviceSubscriptions ServiceSubscription[]
  vendor               Vendor?
  orders               Order[]
  cartItems            CartItem[]
  complaints           Complaint[]
  userReviews          Review[]           @relation("UserReviews")
}

model IdentityDocument {
  id              String             @id @default(uuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentType    String             // e.g. National ID, Passport
  documentNumber  String
  documentUrl     String             // Private path
  status          VerificationStatus @default(PENDING)
  rejectionReason String?
  verifiedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model License {
  id              String             @id @default(uuid())
  ownerId         String
  owner           User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  licenseNumber   String
  documentUrl     String             // Private path
  status          VerificationStatus @default(PENDING)
  rejectionReason String?
  verifiedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model Property {
  id              String          @id @default(uuid())
  ownerId         String
  owner           User            @relation("OwnerProperties", fields: [ownerId], references: [id], onDelete: Cascade)
  title           String
  description     String
  propertyType    String          // Apartment, Villa, Studio, Condominium, Commercial
  transactionType TransactionType
  price           Float
  area            Float           // in sq. meters
  bedrooms        Int
  bathrooms       Int
  city            String
  areaName        String
  neighborhood    String?
  addressDetails  String?
  availability    Boolean         @default(true)
  status          PropertyStatus  @default(PENDING_REVIEW)
  viewsCount      Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  images          PropertyImage[]
  documents       PropertyDocument[]
  rentalRequests  RentalRequest[]
  saleRequests    SaleRequest[]
  favorites       Favorite[]
  messages        Message[]
  reviews         Review[]
  reports         Report[]
  analyticsEvents AnalyticsEvent[]
}

model PropertyImage {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model PropertyDocument {
  id           String             @id @default(uuid())
  propertyId   String
  property     Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  documentType String             // Title Deed, Ownership Certificate, Map
  documentUrl  String             // Private storage path
  status       VerificationStatus @default(PENDING)
  createdAt    DateTime           @default(now())
}

model SubscriptionPlan {
  id            String         @id @default(uuid())
  name          String         // Basic, Professional, Business
  price         Float
  durationDays  Int            @default(30)
  maxListings   Int            @default(5)
  features      String         @default("[]") // JSON string of features
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())

  subscriptions Subscription[]
}

model Subscription {
  id        String             @id @default(uuid())
  ownerId   String
  owner     User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  planId    String
  plan      SubscriptionPlan   @relation(fields: [planId], references: [id])
  status    SubscriptionStatus @default(PENDING)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  payments  Payment[]
}

model Payment {
  id               String        @id @default(uuid())
  ownerId          String?
  owner            User?         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  subscriptionId   String?
  subscription     Subscription? @relation(fields: [subscriptionId], references: [id])
  orderId          String?       @unique
  order            Order?        @relation(fields: [orderId], references: [id])
  serviceBookingId String?       @unique
  serviceBooking   ServiceBooking? @relation(fields: [serviceBookingId], references: [id])
  amount           Float
  currency         String        @default("ETB")
  provider         String        @default("CHAPA_SIMULATION")
  transactionRef   String?       @unique
  chapaTxRef       String?       @unique
  chapaCheckoutUrl String?
  method           String        @default("chapa")
  status           PaymentStatus @default(PENDING)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model RentalRequest {
  id             String            @id @default(uuid())
  propertyId     String
  property       Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  renterId       String
  renter         User              @relation("RenterRequests", fields: [renterId], references: [id], onDelete: Cascade)
  ownerId        String
  owner          User              @relation("OwnerRentalRequests", fields: [ownerId], references: [id], onDelete: Cascade)
  status         RentalStatus      @default(PENDING)
  message        String?
  moveInDate     DateTime?
  durationMonths Int               @default(12)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  agreements     RentalAgreement[]
}


model SaleRequest {
  id         String     @id @default(uuid())
  propertyId String
  property   Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  buyerId    String
  buyer      User       @relation("BuyerRequests", fields: [buyerId], references: [id], onDelete: Cascade)
  ownerId    String
  owner      User       @relation("OwnerSaleRequests", fields: [ownerId], references: [id], onDelete: Cascade)
  status     SaleStatus @default(PENDING)
  offerPrice Float?
  message    String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
}

model Message {
  id         String    @id @default(uuid())
  senderId   String
  sender     User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User      @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  content    String
  isRead     Boolean   @default(false)
  createdAt  DateTime  @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("SYSTEM")
  link      String?
  isRead    Boolean  @default(false)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Review {
  id               String          @id @default(uuid())
  propertyId       String?
  property         Property?       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  authorId         String?
  author           User?           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?           @relation("UserReviews", fields: [userId], references: [id], onDelete: Cascade)
  vendorId         String?
  vendor           Vendor?         @relation(fields: [vendorId], references: [id])
  productId        String?
  product          Product?        @relation(fields: [productId], references: [id])
  serviceBookingId String?         @unique
  serviceBooking   ServiceBooking? @relation(fields: [serviceBookingId], references: [id])
  rating           Int             @default(5)
  comment          String?
  createdAt        DateTime        @default(now())
}

model Report {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  details    String?
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
}



model AIVerification {
  id             String   @id @default(uuid())
  entityType     String   // IdentityDocument, PropertyDocument, License
  entityId       String
  riskScore      Float    @default(0.0) // 0 to 100
  ocrData        String?  // JSON string
  warnings       String?  // JSON string
  recommendation String   @default("MANUAL_REVIEW_REQUIRED")
  createdAt      DateTime @default(now())
}

model AnalyticsEvent {
  id         String    @id @default(uuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  eventType  String    // PROPERTY_VIEW, SEARCH, FAVORITE_ADD, RENTAL_REQUEST, SALE_REQUEST
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  metadata   String?   // JSON string
  createdAt  DateTime  @default(now())
}

model PlatformConfig {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model SavedAddress {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  address   String
  city      String   @default("Addis Ababa")
  lat       Float?
  lng       Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String
  keys      String
  createdAt DateTime @default(now())

  @@unique([userId, endpoint])
}

model Agent {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName     String
  description      String?
  logo             String?
  status           String   @default("PENDING")
  subscriptionPlan String   @default("basic")
  commissionRate   Float    @default(10)
  revenue          Float    @default(0)
  onboardingStep   Int      @default(0)
  businessCategory String?
  taxId            String?
  bankAccount      String?
  contactEmail     String?
  offersServices   Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  products        Product[]
  orders          Order[]
  reviews         Review[]
  messages        VendorMessage[]
  providers       VendorProvider[]
  serviceBookings ServiceBooking[] @relation("VendorBookings")
}








model ServiceSubscription {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId     String
  package       ServicePackage @relation(fields: [packageId], references: [id])
  type          String
  status        String   @default("ACTIVE")
  price         Float
  address       String
  city          String   @default("Addis Ababa")
  nextServiceAt DateTime?
  startedAt     DateTime @default(now())
  endsAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookings ServiceBooking[]
}

model Complaint {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  subject     String
  description String
  status      String   @default("OPEN")
  adminNotes  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}



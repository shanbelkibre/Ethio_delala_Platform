// ============================================================
// Ethio Delala Real Estate Platform - Approved 20-Table 3NF Schema
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum RoleType {
  ADMIN
  AGENT
  OWNER
  RENTER
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum TransactionType {
  RENT
  SALE
}

enum PropertyStatus {
  DRAFT
  PUBLISHED
  SOLD
  RENTED
  SUSPENDED
  ARCHIVED
}

enum RentalStatus {
  PENDING
  ACCEPTED
  REJECTED
  UNDER_REVIEW
  COMPLETED
  CANCELLED
}

enum SaleStatus {
  PENDING
  ACCEPTED
  REJECTED
  UNDER_REVIEW
  COMPLETED
  CANCELLED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
  FAILED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum PaymentMethod {
  CHAPA
}

enum NotificationType {
  SYSTEM
  RENTAL_REQUEST
  SALE_REQUEST
  MESSAGE
  SUBSCRIPTION
  VERIFICATION
  PROPERTY
  REVIEW
  REPORT
}

enum AdminActionType {
  CREATE_USER
  UPDATE_USER
  SUSPEND_USER
  ACTIVATE_USER
  CREATE_AGENT
  UPDATE_AGENT
  VERIFY_USER
  REJECT_VERIFICATION
  PUBLISH_PROPERTY
  SUSPEND_PROPERTY
  DELETE_PROPERTY
  UPDATE_SETTINGS
  RESOLVE_REPORT
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  REJECTED
}

// ============================================================
// 1. ROLE
// ============================================================

model Role {
  id        String   @id @default(uuid())
  name      RoleType @unique
  createdAt DateTime @default(now())

  users User[]
}

// ============================================================
// 2. USER
// ============================================================

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  phone         String        @unique
  passwordHash  String
  roleId        String
  accountStatus AccountStatus @default(ACTIVE)

  role Role @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile              Profile?
  identityVerification IdentityVerification?

  ownedProperties Property[]

  rentalRequests RentalRequest[]
  saleRequests   SaleRequest[]

  subscriptions Subscription[]

  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")

  notifications Notification[]

  favorites Favorite[]
  reviews   Review[]

  reportsFiled       Report[] @relation("ReportsFiled")
  reportsReceived    Report[] @relation("ReportsReceived")

  adminActions       AdminAction[] @relation("AdminActions")
  targetAdminActions AdminAction[] @relation("TargetUserActions")

  resolvedReports Report[] @relation("ResolvedReports")

  analyticsEvents AnalyticsEvent[]
}

// ============================================================
// 3. PROFILE
// ============================================================

model Profile {
  id     String @id @default(uuid())
  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName  String
  middleName String?
  lastName   String?

  gender        String?
  dateOfBirth   DateTime?
  maritalStatus String?

  profileImageUrl String?

  region String?
  zone   String?
  wereda String?
  kebele String?

  // Used only when User has AGENT role
  assignedRegion String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// 4. IDENTITY VERIFICATION
// ============================================================

model IdentityVerification {
  id     String @id @default(uuid())
  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?

  phoneOtpVerified Boolean   @default(false)
  phoneVerifiedAt  DateTime?

  nationalIdReference  String?
  nationalIdVerified   Boolean   @default(false)
  nationalIdVerifiedAt DateTime?

  status VerificationStatus @default(PENDING)

  rejectionReason String?
  verifiedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// 5. PROPERTY
// ============================================================

model Property {
  id      String @id @default(uuid())
  ownerId String

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  title       String
  description String

  propertyType    String
  transactionType TransactionType

  price Decimal @db.Decimal(15, 2)

  areaSqMeters Decimal? @db.Decimal(10, 2)

  rooms     Int?
  bedrooms  Int?
  bathrooms Int?

  region           String
  zone             String?
  wereda           String?
  kebele           String?
  city             String?
  areaName         String?
  detailedLocation String?

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  availability Boolean        @default(true)
  status       PropertyStatus @default(DRAFT)

  viewsCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images         PropertyImage[]
  rentalRequests RentalRequest[]
  saleRequests   SaleRequest[]

  favorites Favorite[]
  messages  Message[]
  reviews   Review[]
  reports   Report[]

  analyticsEvents AnalyticsEvent[]

  @@index([ownerId])
  @@index([region])
  @@index([transactionType])
  @@index([propertyType])
  @@index([price])
  @@index([status])
  @@index([availability])
}

// ============================================================
// 6. PROPERTY IMAGE
// ============================================================

model PropertyImage {
  id         String @id @default(uuid())
  propertyId String

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  url       String
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())

  @@index([propertyId])
}

// ============================================================
// 7. RENTAL REQUEST
// ============================================================

model RentalRequest {
  id String @id @default(uuid())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  renterId String
  renter   User @relation(fields: [renterId], references: [id], onDelete: Cascade)

  status RentalStatus @default(PENDING)

  message String?

  moveInDate     DateTime?
  durationMonths Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@index([propertyId])
  @@index([renterId])
  @@index([status])
}

// ============================================================
// 8. SALE REQUEST
// ============================================================

model SaleRequest {
  id String @id @default(uuid())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  buyerId String
  buyer   User @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  status SaleStatus @default(PENDING)

  offeredPrice Decimal? @db.Decimal(15, 2)

  message String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@index([propertyId])
  @@index([buyerId])
  @@index([status])
}

// ============================================================
// 9. SUBSCRIPTION PLAN
// ============================================================

model SubscriptionPlan {
  id String @id @default(uuid())

  name String @unique

  price        Decimal @db.Decimal(15, 2)
  durationDays Int
  maxListings  Int

  features Json?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
}

// ============================================================
// 10. SUBSCRIPTION
// ============================================================

model Subscription {
  id String @id @default(uuid())

  ownerId String
  owner   User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  planId String
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  status SubscriptionStatus @default(PENDING)

  startDate DateTime?
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments SubscriptionPayment[]

  @@index([ownerId])
  @@index([planId])
  @@index([status])
}

// ============================================================
// 11. SUBSCRIPTION PAYMENT
// ============================================================

model SubscriptionPayment {
  id String @id @default(uuid())

  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  amount   Decimal @db.Decimal(15, 2)
  currency String  @default("ETB")

  paymentMethod PaymentMethod @default(CHAPA)
  paymentStatus PaymentStatus @default(PENDING)

  paymentReference          String  @unique
  chapaTransactionReference String? @unique

  checkoutUrl String?

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subscriptionId])
  @@index([paymentStatus])
}

// ============================================================
// 12. MESSAGE
// ============================================================

model Message {
  id String @id @default(uuid())

  senderId String
  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  receiverId String
  receiver   User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  rentalRequestId String?
  rentalRequest   RentalRequest? @relation(fields: [rentalRequestId], references: [id], onDelete: SetNull)

  saleRequestId String?
  saleRequest   SaleRequest? @relation(fields: [saleRequestId], references: [id], onDelete: SetNull)

  content String

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([senderId])
  @@index([receiverId])
  @@index([propertyId])
  @@index([rentalRequestId])
  @@index([saleRequestId])
}

// ============================================================
// 13. NOTIFICATION
// ============================================================

model Notification {
  id String @id @default(uuid())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String
  message String

  type NotificationType @default(SYSTEM)

  link String?

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([type])
}

// ============================================================
// 14. FAVORITE
// ============================================================

model Favorite {
  id String @id @default(uuid())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, propertyId])
  @@index([propertyId])
}

// ============================================================
// 15. REVIEW
// ============================================================

model Review {
  id String @id @default(uuid())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  rating  Int
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, propertyId])
  @@index([propertyId])
}

// ============================================================
// 16. ADMIN ACTION
// ============================================================

model AdminAction {
  id String @id @default(uuid())

  adminId String
  admin   User @relation("AdminActions", fields: [adminId], references: [id], onDelete: Cascade)

  targetUserId String?
  targetUser   User? @relation("TargetUserActions", fields: [targetUserId], references: [id], onDelete: SetNull)

  actionType AdminActionType

  description String?

  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([targetUserId])
  @@index([actionType])
}

// ============================================================
// 17. REPORT
// ============================================================

model Report {
  id String @id @default(uuid())

  reporterId String
  reporter   User @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  reportedUserId String?
  reportedUser   User? @relation("ReportsReceived", fields: [reportedUserId], references: [id], onDelete: SetNull)

  reason  String
  details String?

  status ReportStatus @default(PENDING)

  resolvedById String?
  resolvedBy   User? @relation("ResolvedReports", fields: [resolvedById], references: [id], onDelete: SetNull)

  resolutionNotes String?
  resolvedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reporterId])
  @@index([propertyId])
  @@index([reportedUserId])
  @@index([resolvedById])
  @@index([status])
}

// ============================================================
// 18. ANALYTICS EVENT
// ============================================================

model AnalyticsEvent {
  id String @id @default(uuid())

  eventType String

  userId String?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  metadata Json?

  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([userId])
  @@index([propertyId])
  @@index([createdAt])
}

// ============================================================
// 19. PLATFORM CONFIG
// ============================================================

model PlatformConfig {
  key String @id

  value       String
  description String?

  updatedAt DateTime @updatedAt
}

// ============================================================
// 20. AI VERIFICATION
// ============================================================

model AIVerification {
  id String @id @default(uuid())

  entityType String
  entityId   String

  riskScore Int

  ocrData  Json?
  warnings Json?

  recommendation String

  createdAt DateTime @default(now())

  @@index([entityType])
  @@index([entityId])
  @@index([riskScore])
}